        "jsonBody": "{\"chat_id\": YOUR_TELEGRAM_CHAT_ID, \"question\": \"🌊🎉 SWELL EVENT — lock it in?\", \"options\": [\"I'm in 🤙\", \"Can't make it 😔\"], \"is_anonymous\": false}",
