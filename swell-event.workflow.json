    {
      "parameters": {
        "jsCode": "\nlet fitem=$('Apify Flights').first().json; if(Array.isArray(fitem))fitem=fitem[0];\nconst flights=(fitem&&fitem.all_flights)||[];\nconst cf=flights.filter(x=>x.price).sort((a,b)=>a.price-b.price)[0]||{};\nconst direct=(cf.stops===0||cf.stops==='0')?', direct':'';\nconst flightLine=`from A$${cf.price} return (${cf.airlines||'?'}${direct})`;\nlet villas=$('Apify Villa').all().map(i=>i.json);\nif(villas.length===1&&Array.isArray(villas[0]))villas=villas[0];\nif(villas.length===1&&villas[0]&&Array.isArray(villas[0].data))villas=villas[0].data;\nfunction pn(it){const d=(((it.price||{}).breakDown||{}).basePrice||{}).description||'';const m=d.match(/x\\s*\\$?([\\d,.]+)/);return m?Math.round(parseFloat(m[1].replace(/,/g,''))):null;}\nconst vp=villas.map(v=>({pn:pn(v),url:(v.url||'').split('?')[0]})).filter(v=>v.pn).sort((a,b)=>a.pn-b.pn);\nconst cv=vp[0]||{};\nreturn [{json:{flightLine,villaPrice:cv.pn,villaUrl:cv.url||'https://www.airbnb.com'}}];\n"
      },
