        "jsCode": "\n// Build the flight-options email from the Apify flights scrape (top 4 cheapest).\nlet fitem=$('Apify Flights').first().json; if(Array.isArray(fitem))fitem=fitem[0];\nconst flights=((fitem&&fitem.all_flights)||[]).filter(x=>x.price).sort((a,b)=>a.price-b.price).slice(0,4);\nconst s=$('Evaluate swell').first().json;\nconst rows=flights.length\n  ? flights.map((f,i)=>`${i+1}. A$${f.price} — ${f.airlines} (${(f.stops===0||f.stops==='0')?'direct':(f.stops||'?')+' stop'})`).join('\\n')\n  : \"(no live flights in pinned data)\";\nconst subject=`🌊 HELL SWELL — Bali flights to book (${s.departDate} → ${s.returnDate})`;\nconst message=`Uluwatu's firing. Flights PER→DPS for ${s.departDate} → ${s.returnDate}:\\n\\n${rows}\\n\\n`+\n  `Book one and the workflow takes over — it's now watching your inbox for the airline confirmation, then it tracks the flight and books the taxi + beers.`;\nreturn [{json:{subject,message,to:\"YOUR_EMAIL@example.com\"}}];\n"
