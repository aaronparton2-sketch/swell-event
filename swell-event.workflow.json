    {
      "parameters": {
        "jsCode": "\nconst s=$('Evaluate swell').first().json, p=$('Pick cheapest').first().json;\nlet short=$('Shorten villa').first().json;\nshort=(typeof short==='string')?short:(short.data||short.body||'');\nif(!/^https:\\/\\/da\\.gd\\//.test(short)) short=p.villaUrl; // fallback to clean full url if v.gd errored\nconst message=`🌊🎉 SWELL EVENT — Uluwatu is about to PUMP\n\n📏 Surf: up to ${s.peakMin}-${s.peakMax}ft (${s.peakHuman})\n🧭 Wind: ${s.windKts}kts ${s.windDir}, OFFSHORE and clean\n📅 Firing ${s.onDays} days straight:\n\n${s.swellLines}\n\n✈️ Flights PER→DPS: ${p.flightLine}\n🏝️ Villa: A$${p.villaPrice}/night → ${short}\n\n📊 Forecast: ${s.surfShort}\n\n👇 Boys — you in?`;\nreturn [{json:{message}}];\n"
