    {
      "parameters": {
        "jsCode": "\nconst MIN_SURF=5, MIN_ON_DAYS=3, FORCE_FIRE=false; // FORCE_FIRE=true to fire on camera anytime\nconst rows=$('Forecast').all().map(i=>i.json);\nconst TZ=8*3600;\nconst dShort=ts=>new Date((ts+TZ)*1000).toUTCString().slice(0,3);\nconst dISO=ts=>new Date((ts+TZ)*1000).toISOString().slice(0,10);\nconst days={}; let peak=null; const onISO=[];\nfor(const r of rows){\n  const on=r.surfMax>=MIN_SURF && r.offshore;\n  if(on){const k=dShort(r.ts);\n    if(!days[k]||r.surfMax>days[k].max) days[k]={max:r.surfMax,line:`${r.swH.toFixed(1)}m @ ${r.swP}s ${r.swDirC} (${Math.round(r.swD)}°)`};\n    const iso=dISO(r.ts); if(!onISO.includes(iso))onISO.push(iso);}\n  if(!peak||r.surfMax>peak.surfMax)peak=r;\n}\nconst swellOn=FORCE_FIRE||onISO.length>=MIN_ON_DAYS;\nconst swellLines=Object.entries(days).map(([k,v])=>`${k}: ${v.line}`).join('\\n');\nconst departDate=onISO[0]||dISO(rows[0].ts);\nconst rt=new Date((onISO[onISO.length-1]||departDate)+'T00:00:00Z'); rt.setUTCDate(rt.getUTCDate()+1);\nreturn [{json:{swellOn,departDate,returnDate:rt.toISOString().slice(0,10),swellLines,\n  peakMin:peak.surfMin,peakMax:peak.surfMax,peakHuman:peak.human,\n  windKts:peak.windKts,windDir:peak.windDir,onDays:onISO.length||3,\n  surfShort:\"https://da.gd/DU6oz\"}}];\n"
      },
