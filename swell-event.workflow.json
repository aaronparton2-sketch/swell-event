    {
      "parameters": {
        "jsCode": "function load(name){const it=$(name).first().json;if(it&&it.data&&(Array.isArray(it.data.wave)||Array.isArray(it.data.wind)))return it;let raw=(typeof it==='string')?it:(typeof it.data==='string')?it.data:(typeof it.body==='string')?it.body:JSON.stringify(it);return JSON.parse(raw);}\nconst wave=load('Surfline Wave').data.wave, wind=load('Surfline Wind').data.wind;\nconst wb={}; for(const w of wind) wb[w.timestamp]=w;\nconst C=['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSW','SW','WSW','W','WNW','NW','NNW'];\nconst cd=d=>C[Math.round((d||0)/22.5)%16]; const TZ=8*3600;\nconst out=[];\nfor(const wv of wave){\n  const wd=wb[wv.timestamp]||{};\n  const prim=wv.swells.reduce((a,b)=>b.height>a.height?b:a);\n  const t=new Date((wv.timestamp+TZ)*1000);\n  const firing = wv.surf.max>=5 && wd.directionType==='Offshore';\n  out.push({json:{\n    time: t.toUTCString().slice(0,17),\n    surf: `${wv.surf.min}-${wv.surf.max}ft`,\n    swell: `${prim.height.toFixed(1)}m @ ${prim.period}s ${cd(prim.direction)}`,\n    wind: `${Math.round(wd.speed||0)}kts ${cd(wd.direction)} ${wd.directionType||''}`.trim(),\n    firing: firing ? '🔥' : '',\n    ts: wv.timestamp, surfMin: wv.surf.min, surfMax: wv.surf.max, human: wv.surf.humanRelation,\n    swH: prim.height, swP: prim.period, swD: prim.direction, swDirC: cd(prim.direction),\n    windKts: Math.round(wd.speed||0), windDir: cd(wd.direction), offshore: wd.directionType==='Offshore'\n  }});\n}\nreturn out;\n"
      },
